{
  "type": "module",
  "name": "react-dark-theme-context",
  "version": "1.0.0",
  "description": "Tools to detect, switch and save dark theme for react applications",
  "author": "Vadim Taits <taizvadim@gmail.com>",
  "repository": "git@github.com:vtaits/react-dark-theme-context.git",
  "homepage": "https://github.com/vtaits/react-dark-theme-context",
  "keywords": [
    "react",
    "theme",
    "switch",
    "switching",
    "dark",
    "prefers",
    "color",
    "scheme",
    "prefers-color-scheme"
  ],
  "files": [
    "dist",
    "src",
    "!src/stories",
    "!src/**/*.test.js",
    "!src/**/*.test.jsx"
  ],
  "main": "./src/index.js",
  "module": "./src/index.js",
  "typings": "dist/ts/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/ts/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "start": "storybook dev -p 6006",
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check",
    "lint:fix": "biome check --write --unsafe",
    "test:ts": "tsc --noEmit",
    "test:unit": "vitest run --coverage.enabled --coverage.all --coverage.include=src --coverage.exclude=src/stories",
    "test:unit:watch": "vitest",
    "test": "bun run lint && bun run test:ts && bun run test:unit",
    "prepare": "bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@storybook/react-vite": "^10.6.4",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "@types/bun": "latest"
  },
  "dependencies": {
    "use-local-storage-state": "^20.0.0",
    "use-prefers-color-scheme": "^1.1.3"
  }
}
